APP_NAME=VeloraAi
APP_ENV=development
APP_DEBUG=false

# Development can use SQLite. Production should use PostgreSQL.
DATABASE_URL=sqlite:///./velora.db

# Required in production. Generate a long random value.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=45
AI_MAX_HISTORY_MESSAGES=30
AI_MAX_RETRIES=2

RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
# Production should use shared storage, for example redis://:password@host:6379/0
RATE_LIMIT_STORAGE_URI=memory://

# Comma-separated browser origins allowed to call the API.
# Example: https://velora.example.com,https://www.velora.example.com
CORS_ORIGINS=
