APP_NAME=VeloraAi
APP_ENV=development
APP_DEBUG=false

# Development can use SQLite. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./velora.db

# Required in production. Generate a long random value.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI provider: mock, openai, or llama. Production must use a real provider.
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Llama can point to an OpenAI-compatible server.
LLAMA_API_KEY=
LLAMA_MODEL=Llama-3.1-8B-Instruct
LLAMA_BASE_URL=http://localhost:11434/v1

# Embedding provider. Can be separate from the chat model/provider.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536

AI_TIMEOUT_SECONDS=45
AI_MAX_HISTORY_MESSAGES=30
AI_MAX_RETRIES=2

# Request size limits. The global limit should be >= document upload limit.
DOCUMENT_MAX_UPLOAD_BYTES=10485760
MAX_REQUEST_BODY_BYTES=12582912

# Durable RAG worker. Run `python -m app.worker` as a separate service/process.
RAG_WORKER_POLL_SECONDS=5
RAG_WORKER_BATCH_SIZE=4
RAG_PROCESSING_STALE_SECONDS=900

# Midtrans. Development defaults to sandbox; production must explicitly switch.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com
PAYMENT_TIMEOUT_SECONDS=15
PRO_PRICE_IDR=0
MAX_PRICE_IDR=0

RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
# Production must use shared storage, for example redis://:password@host:6379/0
RATE_LIMIT_STORAGE_URI=memory://

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=

# External tool credentials. Keep these in deployment secrets, never in Git.
GITHUB_TOKEN=
VERCEL_TOKEN=
RAILWAY_TOKEN=
CLOUDFLARE_API_TOKEN=
SUPABASE_ACCESS_TOKEN=

# Terminal must point to an isolated sandbox service. VeloraAi never executes
# untrusted tool commands directly on the application host.
TERMINAL_SANDBOX_URL=
TERMINAL_SANDBOX_TOKEN=
