# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=VeloraAi
APP_ENV=development
APP_DEBUG=false
APP_VERSION=0.0.0-dev
GIT_SHA=unknown
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# Development may use SQLite. Production must use PostgreSQL.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./velora.db
# Production MUST set a dedicated schema; "public" is refused at boot.
DATABASE_SCHEMA=public
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE_SECONDS=1800

# ---------------------------------------------------------------------------
# Authentication
# Generate values with: python -m scripts.generate_keys
# ---------------------------------------------------------------------------
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_ACTIVE_SESSIONS=10
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=48
# Must be true in production.
REQUIRE_EMAIL_VERIFICATION=false
FRONTEND_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Credential encryption (per-user third-party tokens)
# Comma-separated; the FIRST key encrypts, all keys decrypt. Required in
# production. Rotate with scripts/rotate_credential_keys.py.
# ---------------------------------------------------------------------------
CREDENTIAL_ENCRYPTION_KEYS=
# Development only. Lets tools fall back to the shared *_TOKEN variables below.
# Refused at boot in production because it breaks tenant isolation.
ALLOW_ENV_TOOL_CREDENTIALS=false

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLAMA_API_KEY=
LLAMA_MODEL=Llama-3.1-8B-Instruct
LLAMA_BASE_URL=http://localhost:11434/v1

EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
# Inputs per embeddings request. Long documents are split into batches because
# providers cap both array length and tokens per call.
EMBEDDING_BATCH_SIZE=96

AI_TIMEOUT_SECONDS=45
AI_MAX_HISTORY_MESSAGES=30
AI_MAX_RETRIES=2
DOCUMENT_MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Payments
# Which gateway handles web checkout. Adding a provider means implementing the
# contract in app/services/payments/base.py and registering it; nothing in the
# subscription logic needs to change.
# ---------------------------------------------------------------------------
# Set to `disabled` while you are not selling yet: production then skips the
# gateway and pricing requirements instead of refusing to boot.
PAYMENT_PROVIDER=disabled

# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com
PAYMENT_TIMEOUT_SECONDS=15
PRO_PRICE_IDR=0
MAX_PRICE_IDR=0

# Billing lifecycle
SUBSCRIPTION_PERIOD_DAYS=30
SUBSCRIPTION_GRACE_DAYS=3
# Indonesian PPN is 12%. Prices above are treated as tax-inclusive.
VAT_PERCENT=0

# ---------------------------------------------------------------------------
# Networking, rate limiting, CORS
# ---------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_CHAT=30/minute
# Production must use shared storage, e.g. redis://:password@host:6379/0
RATE_LIMIT_STORAGE_URI=memory://
# Comma-separated browser origins allowed to call the API. https only in production.
CORS_ORIGINS=
# Comma-separated Host header allowlist. Required in production.
TRUSTED_HOSTS=

# ---------------------------------------------------------------------------
# Outbound email
# Required in production: verification and password-reset links are undeliverable
# without it. Leave SMTP_HOST empty in development and the links are logged.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=VeloraAi <no-reply@example.com>
# Implicit TLS (port 465). Mutually exclusive with STARTTLS.
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
# Bearer token guarding /api/v1/metrics. Required in production.
METRICS_TOKEN=
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Sandboxed terminal
# VeloraAi never executes untrusted tool commands on the application host.
# ---------------------------------------------------------------------------
TERMINAL_SANDBOX_URL=
TERMINAL_SANDBOX_TOKEN=

# ---------------------------------------------------------------------------
# LEGACY / DEVELOPMENT ONLY
# These shared operator tokens are used only when ALLOW_ENV_TOOL_CREDENTIALS
# is true. In production every user connects their own credential through
# PUT /api/v1/integrations and these must be left empty.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
VERCEL_TOKEN=
RAILWAY_TOKEN=
CLOUDFLARE_API_TOKEN=
SUPABASE_ACCESS_TOKEN=
